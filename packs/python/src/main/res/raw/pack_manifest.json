  "warmupActivity": "org.pocketide.python.PythonWarmupActivity",
  "workspaceOutput": "changes-v1",
  "source": "https://github.com/LotusXanderYang/PocketPythonIDE",
  "license": "MIT (pack); PSF-2.0 and dependency licenses in THIRD_PARTY_NOTICES.md",
  "dependencies": [
    {"name": "python", "version": "3.14.6-1", "license": "PSF-2.0"},
    {"name": "libandroid-posix-semaphore", "version": "0.1-4", "license": "MIT"},
    {"name": "libandroid-support", "version": "29", "license": "Apache-2.0; MIT"},
    {"name": "libbz2", "version": "1.0.8-8", "license": "BSD"},
    {"name": "libexpat", "version": "2.9.0", "license": "MIT"},
    {"name": "libffi", "version": "3.8.0", "license": "MIT"},
    {"name": "gdbm", "version": "1.26-1", "license": "GPL-3.0"},
    {"name": "liblzma", "version": "5.8.4", "license": "LGPL-2.1; GPL-2.0; GPL-3.0"},
    {"name": "ncurses", "version": "6.6.20260307+really6.5.20250830", "license": "MIT"},
    {"name": "openssl", "version": "1:3.6.5", "license": "Apache-2.0"},
    {"name": "readline", "version": "8.3.6", "license": "GPL-3.0"},
    {"name": "libsqlite", "version": "3.54.1", "license": "Public Domain"},
    {"name": "zlib", "version": "1.3.2", "license": "Zlib"},
    {"name": "zstd", "version": "1.5.7-1", "license": "GPL-2.0"}
