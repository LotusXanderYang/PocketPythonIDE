  "selfTests": {
    "initialize": {"expectOutput": "Python 3.14.6"},
    "analyze": {"source": "import json\nprint(json.dumps({'ok': True}))\n", "expectStatus": "ok", "expectOutput": "语法检查通过"},
    "complete": {"source": "pri", "expectStatus": "ok", "expectOutput": "print"},
    "run": {"source": "import json\nprint('python-pack-ok', json.loads('{\"n\": 42}')['n'])\n", "expectStatus": "ok", "expectOutput": "python-pack-ok 42"},
    "diagnostics": {"source": "def broken(:\n    pass\n", "expectStatus": "error", "expectErrorCode": "SYNTAX_ERROR", "expectLine": 1},
    "debug": {"entryPath": "fixture.py", "source": "from helper import twice\nvalue = twice(21)\nprint(value)\nraise ValueError('stage8-probe')\n", "secondaryPath": "helper.py", "secondarySource": "def twice(number):\n    answer = number * 2\n    return answer\n", "breakpointLine": 2, "variableName": "number", "variableValue": "21", "exceptionLine": 4, "exceptionId": "ValueError", "exitCode": 1, "pauseSource": "counter = 0\nwhile counter < 10000000:\n    counter += 1\n"},
    "cancel": {"operation": "run", "source": "while True: pass\n"},
    "largeOutput": {"source": "print('x' * 1100000)\n", "minBytes": 1000000},
    "versionMismatch": {},
    "crashRecovery": {}
  }
}
